{
  "name": "CINEMAGIC",
  "short_name": "CINEMAGIC",
  "id": "/app-story/",
  "start_url": "/app-story/",
  "scope": "/app-story/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#222222",
  "description": "Aplikasi berbagi cerita dengan peta, kamera, dan pengalaman PWA.",
  "icons": [
    {
      "src": "/app-story/favicon.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/app-story/images/logo.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "+ Tambah Story",
      "short_name": "Tambah",
      "description": "Buka halaman tambah story",
      "url": "/app-story/#/add-story",
      "icons": [{ "src": "/app-story/images/logo.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Lihat Stories",
      "short_name": "Stories",
      "description": "Buka daftar stories",
      "url": "/app-story/#/stories",
      "icons": [{ "src": "/app-story/images/logo.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "categories": ["social", "productivity"],
  "prefer_related_applications": false
}